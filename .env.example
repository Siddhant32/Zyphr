# Supabase project settings (server-side values stay out of browser bundles)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_DOCS_BUCKET=practical-documents
SUPABASE_COVERS_BUCKET=practical-covers

# Comma-separated Supabase Auth user UUIDs permitted to administer Zyphr.
ADMIN_USER_IDS=

# Public frontend origin(s), comma-separated. Include local frontend during development.
FRONTEND_ORIGINS=http://localhost:3000

# API and processing limits
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
MAX_UPLOAD_BYTES=20971520
MAX_DOCX_UNCOMPRESSED_BYTES=104857600
MAX_COVER_BYTES=5242880
GENERATION_RATE_LIMIT=10
GENERATION_RATE_WINDOW_SECONDS=3600
LIBREOFFICE_TIMEOUT_SECONDS=45

# Browser-visible Supabase Auth settings (anon/public key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_CONTACT_EMAIL=
